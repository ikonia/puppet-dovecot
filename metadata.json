{
  "name": "cirrax-dovecot",
  "version": "1.3.3",
  "author": "Cirrax GmbH",
  "summary": "A module to configure dovecot",
  "license": "GPL-3.0",
  "source": "https://github.com/cirrax/puppet-dovecot",
  "project_page": "https://github.com/cirrax/puppet-dovecot",
  "issues_url": "https://github.com/cirrax/puppet-dovecot/issues",
  "dependencies": [
    {
      "name": "puppetlabs/stdlib",
      "version_requirement": ">= 3.2.0 < 10.0.0"
    },
    {
      "name": "puppetlabs/concat",
      "version_requirement": ">= 5.0.0 < 10.0.0"
    }
  ],
  "operatingsystem_support": [
    {
      "operatingsystem": "Debian",
      "operatingsystemrelease": [
        "9",
        "10",
        "11",
        "12"
      ]
    },
    {
      "operatingsystem": "Ubuntu"
    },
    {
      "operatingsystem": "RedHat",
      "operatingsystemrelease": [
        "10"
      ]
    },
    {
      "operatingsystem": "Rocky",
      "operatingsystemrelease": [
        "10"
      ]
    },
    {
      "operatingsystem": "AlmaLinux",
      "operatingsystemrelease": [
        "10"
      ]
    }
  ],
  "requirements": [
    {
      "name": "openvox",
      "version_requirement": ">=4.0.0 < 9.0.0"
    }
  ],
  "tags": [
    "dovecot",
    "mail",
    "pop",
    "imap"
  ]
}
